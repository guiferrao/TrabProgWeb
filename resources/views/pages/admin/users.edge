<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Gestão de Utilizadores</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800">

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Painel Administrativo</h1>
        <p class="text-gray-500 mt-1">Gestão de utilizadores e prestadores de serviços.</p>
      </div>
      <div class="flex gap-4">
        <a href="/admin/videos" class="text-blue-600 font-medium hover:underline text-sm flex items-center">Gerir Vídeos</a>
        <a href="/videos" class="text-gray-600 font-medium hover:underline text-sm flex items-center">← Voltar para o Feed</a>
      </div>
    </div>

    <!-- Tabela de Utilizadores -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <th class="p-4">Nome Completo</th>
            <th class="p-4">Username</th>
            <th class="p-4">Função</th>
            <th class="p-4">Data de Registro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-sm">
          @each(user in users)
            <tr class="hover:bg-gray-50 transition">
              <td class="p-4 font-medium text-gray-900 flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs">
                  {{ user.initials || 'US' }}
                </div>
                <span>{{ user.fullName }}</span>
              </td>
              <td class="p-4 text-gray-600">{{ user.username }}</td>
              <td class="p-4">
                <span class="px-2.5 py-1 bg-purple-50 text-purple-700 rounded-full text-xs font-semibold capitalize">
                  {{ user.role || 'user' }}
                </span>
              </td>
              <td class="p-4 text-gray-500 text-xs">
                {{ user.createdAt ? user.createdAt.toFormat('dd/MM/yyyy HH:mm') : '-' }}
              </td>
            </tr>
          @endeach
        </tbody>
      </table>

      @if(users.length === 0)
        <div class="text-center py-12 text-gray-500">
          Nenhum utilizador registado no sistema.
        </div>
      @end
    </div>
  </div>

</body>
</html>