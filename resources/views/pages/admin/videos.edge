<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Gestão de Vídeos</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen text-gray-800">

  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Painel Administrativo</h1>
        <p class="text-gray-500 mt-1">Moderação e gestão de vídeos da plataforma.</p>
      </div>
      <a href="/videos" class="text-blue-600 font-medium hover:underline text-sm">← Voltar para o Feed</a>
    </div>

    <!-- Tabela de Vídeos -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <th class="p-4">Título</th>
            <th class="p-4">Categoria</th>
            <th class="p-4">Autor</th>
            <th class="p-4">Visibilidade</th>
            <th class="p-4">Visualizações</th>
            <th class="p-4 text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 text-sm">
          @each(video in videos)
            <tr class="hover:bg-gray-50 transition">
              <td class="p-4 font-medium text-gray-900 flex items-center gap-3">
                <video src="{{ video.videoUrl }}" class="w-10 h-14 object-cover rounded bg-black"></video>
                <span class="line-clamp-1">{{ video.title }}</span>
              </td>
              <td class="p-4">
                <span class="px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-semibold">
                  {{ video.category }}
                </span>
              </td>
              <td class="p-4 text-gray-600">{{ video.user ? video.user.fullName : 'Desconhecido' }}</td>
              <td class="p-4 text-gray-500 capitalize">{{ video.visibility }}</td>
              <td class="p-4 text-gray-600">👁️ {{ video.views }}</td>
              <td class="p-4 text-right">
                <form action="/admin/videos/{{ video.id }}/delete" method="POST" onsubmit="return confirm('Tens a certeza que pretendes apagar este vídeo?');">
                  {{ csrfField() }}
                  <button type="submit" class="px-3 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 rounded-md font-medium text-xs transition">
                    Apagar
                  </button>
                </form>
              </td>
            </tr>
          @endeach
        </tbody>
      </table>

      @if(videos.length === 0)
        <div class="text-center py-12 text-gray-500">
          Nenhum vídeo registado no sistema.
        </div>
      @end
    </div>
  </div>

</body>
</html>