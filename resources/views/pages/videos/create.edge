<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enviar Vídeo - TrabProgWeb</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 min-h-screen text-gray-800">

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-slate-900">Enviar vídeo</h1>
      <p class="text-gray-500 mt-1">Vídeos verticais (9:16) de até 60 segundos. MP4 ou WebM, máximo 100 MB.</p>
    </div>

    <!-- enctype="multipart/form-data" é OBRIGATÓRIO para envio de arquivos -->
    <form action="/videos" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 flex flex-col md:flex-row gap-8">
      {{ csrfField() }}

      <!-- Coluna da Esquerda: Upload de Arquivo -->
      <div class="w-full md:w-1/3">
        <label for="video" class="flex flex-col items-center justify-center w-full h-96 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition">
          <div class="flex flex-col items-center justify-center pt-5 pb-6">
            <svg class="w-10 h-10 mb-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            <p class="mb-2 text-sm text-gray-600 font-medium">Arraste o vídeo aqui</p>
            <p class="text-xs text-gray-400">ou clique para escolher</p>
          </div>
          <input id="video" name="video" type="file" accept="video/mp4,video/webm" class="hidden" required />
        </label>
        @inputError('video')
          <span class="text-red-500 text-xs mt-2 block">{{ $messages.join(', ') }}</span>
        @end
      </div>

      <!-- Coluna da Direita: Informações do Vídeo -->
      <div class="w-full md:w-2/3 space-y-6">
        
        <!-- Título -->
        <div>
          <label for="title" class="block text-sm font-medium text-gray-700 mb-1">Título</label>
          <input type="text" id="title" name="title" placeholder="Dê um título ao seu vídeo" required
                 class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-blue-600 focus:border-blue-600">
        </div>

        <!-- Descrição -->
        <div>
          <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Descrição</label>
          <textarea id="description" name="description" rows="3" placeholder="Conte do que se trata. Use #tags para facilitar a busca." required
                    class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-blue-600 focus:border-blue-600"></textarea>
        </div>

        <!-- Categoria -->
        <div>
          <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Categoria</label>
          <select id="category" name="category" required
                  class="w-full border border-gray-300 rounded-md p-2.5 focus:ring-blue-600 focus:border-blue-600 bg-white">
            <option value="" disabled selected>Selecione a área de atuação...</option>
            <option value="Tecnologia e TI">Tecnologia e TI</option>
            <option value="Design e Criativo">Design e Criativo</option>
            <option value="Manutenção e Obras">Manutenção e Obras</option>
            <option value="Aulas e Consultoria">Aulas e Consultoria</option>
            <option value="Saúde e Bem-estar">Saúde e Bem-estar</option>
            <option value="Eventos e Audiovisual">Eventos e Audiovisual</option>
            <option value="Serviços Automotivos">Serviços Automotivos</option>
          </select>
        </div>

        <!-- Visibilidade -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Visibilidade</label>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <label class="border border-gray-300 rounded-md p-3 flex items-start gap-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 transition">
              <input type="radio" name="visibility" value="public" class="mt-1 text-blue-600" checked>
              <div>
                <span class="block text-sm font-medium text-gray-900">Público</span>
                <span class="block text-xs text-gray-500">Todos podem ver</span>
              </div>
            </label>
            <label class="border border-gray-300 rounded-md p-3 flex items-start gap-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 transition">
              <input type="radio" name="visibility" value="unlisted" class="mt-1 text-blue-600">
              <div>
                <span class="block text-sm font-medium text-gray-900">Não listado</span>
                <span class="block text-xs text-gray-500">Só quem tem o link</span>
              </div>
            </label>
            <label class="border border-gray-300 rounded-md p-3 flex items-start gap-3 cursor-pointer hover:bg-gray-50 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 transition">
              <input type="radio" name="visibility" value="private" class="mt-1 text-blue-600">
              <div>
                <span class="block text-sm font-medium text-gray-900">Privado</span>
                <span class="block text-xs text-gray-500">Só você</span>
              </div>
            </label>
          </div>
        </div>

        <!-- Botões de Ação -->
        <div class="pt-4 flex justify-end gap-3 border-t border-gray-100">
          <a href="/" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50">Cancelar</a>
          <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-md hover:bg-blue-800 transition">Publicar</button>
        </div>

      </div>
    </form>
  </div>

<script>
    const videoInput = document.getElementById('video');
    const uploadContainer = videoInput.closest('label');

    videoInput.addEventListener('change', function(event) {
      const file = event.target.files[0];
      if (file) {
        // Altera o conteúdo visual da caixa para mostrar o nome do vídeo selecionado
        uploadContainer.querySelector('div').innerHTML = `
          <svg class="w-10 h-10 mb-3 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <p class="mb-2 text-sm text-green-600 font-semibold text-center px-2">Vídeo selecionado:</p>
          <p class="text-xs text-gray-600 text-center px-2 truncate max-w-[250px]">${file.name}</p>
        `;
        uploadContainer.classList.remove('border-gray-300', 'bg-gray-50');
        uploadContainer.classList.add('border-green-500', 'bg-green-50');
      }
    });
  </script>
  
</body>
</html>