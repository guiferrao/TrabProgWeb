<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ video.title }} - RuralStream</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen text-gray-100 flex flex-col items-center justify-center p-4">

  <div class="w-full max-w-4xl mb-4">
    <a href="/videos" class="text-sm text-gray-400 hover:text-white transition flex items-center gap-2">
      ← Voltar para o Feed
    </a>
  </div>

  <div class="w-full max-w-4xl bg-gray-800 border border-gray-700 rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row">
    
    <!-- Lado Esquerdo: Player de Vídeo em Destaque (Vertical 9:16) -->
    <div class="w-full md:w-1/2 bg-black flex items-center justify-center p-4">
      <div class="h-[600px] w-full max-w-[340px] bg-black rounded-xl overflow-hidden shadow-inner">
        <video src="{{ video.videoUrl }}" class="w-full h-full object-cover" controls autoplay></video>
      </div>
    </div>

    <!-- Lado Direito: Detalhes do Vídeo e do Prestador (Estilo LinkedIn/Perfil) -->
    <div class="w-full md:w-1/2 p-6 flex flex-col justify-between">
      
      <div>
        <!-- Categoria e Visibilidade -->
        <div class="flex justify-between items-center mb-4">
          <span class="text-xs font-semibold px-3 py-1 bg-blue-600/20 text-blue-400 rounded-full uppercase tracking-wider">
            {{ video.category }}
          </span>
          <span class="text-xs text-gray-400">👁️ {{ video.views }} visualizações</span>
        </div>

        <!-- Título e Descrição -->
        <h1 class="text-2xl font-bold text-white mb-3">{{ video.title }}</h1>
        <p class="text-gray-300 text-sm mb-6 leading-relaxed bg-gray-900/50 p-4 rounded-xl border border-gray-700/50">
          {{ video.description }}
        </p>
      </div>

      <!-- Card do Prestador de Serviços (Estilo LinkedIn) -->
      <div class="mt-6 pt-6 border-t border-gray-700">
        <p class="text-xs text-gray-400 mb-3 font-medium uppercase tracking-wider">Publicado por:</p>
        <div class="flex items-center gap-4 bg-gray-900/80 p-4 rounded-xl border border-gray-700">
          <!-- Iniciais do avatar -->
          <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow">
            {{ video.user ? video.user.initials : 'US' }}
          </div>
          <div>
            <h3 class="font-bold text-white text-base">{{ video.user ? video.user.fullName : 'Prestador' }}</h3>
            <p class="text-xs text-gray-400">{{ video.user ? video.user.username : '' }}</p>
          </div>
        </div>
      </div>

    </div>
  </div>

</body>
</html>