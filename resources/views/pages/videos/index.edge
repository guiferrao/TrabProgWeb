<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feed - SEM NOME AINDA</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen text-gray-800">

  <div class="max-w-7xl mx-auto px-4 py-8">
    
    <!-- Cabeçalho com Título e Botão de Enviar -->
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">Para você</h1>
        <p class="text-gray-500 text-sm mt-0.5">Conectando profissionais e serviços em formato vertical.</p>
      </div>
      <a href="/videos/enviar" class="bg-blue-700 hover:bg-blue-800 text-white font-medium px-4 py-2 rounded-lg transition text-sm shadow-sm">
        + Enviar vídeo
      </a>
    </div>

    <!-- Barra de Pesquisa Longa (Estilo da referência) -->
    <div class="mb-8">
      <form action="/videos" method="GET" class="flex items-center gap-3 w-full">
        <div class="relative flex-grow">
          <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
            🔍
          </span>
          <input type="text" name="search" value="{{ search || '' }}" placeholder="Buscar vídeos, #tags ou @pessoas" 
                 class="w-full pl-11 pr-4 py-3 bg-white border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:outline-none shadow-sm">
        </div>
        
        <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-medium px-6 py-3 rounded-xl text-sm transition shadow-sm whitespace-nowrap">
          Buscar
        </button>

        @if(search)
          <a href="/videos" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-3 rounded-xl text-sm transition flex items-center justify-center font-medium" title="Limpar pesquisa">
            ✕ Limpar
          </a>
        @end
      </form>
    </div>

    <!-- Grelha de Vídeos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      @each(video in videos)
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden flex flex-col">
          <a href="/videos/{{ video.id }}" class="block relative bg-black h-96">
            <video src="{{ video.videoUrl }}" class="w-full h-full object-cover pointer-events-none"></video>
        </a>
          
          <!-- Informações do Vídeo -->
          <div class="p-4 flex flex-col flex-grow">
            <span class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1">{{ video.category }}</span>
            <h3 class="font-bold text-gray-900 text-base line-clamp-2 mb-2">{{ video.title }}</h3>
            <p class="text-xs text-gray-500 mb-4 line-clamp-2">{{ video.description }}</p>
            
            <div class="mt-auto pt-3 border-t border-gray-100 flex justify-between items-center text-xs text-gray-500">
              <span>Por: <strong>{{ video.user ? video.user.fullName : 'Anônimo' }}</strong></span>
              <span>👁️ {{ video.views }} visualizações</span>
            </div>
          </div>
        </div>
      @endeach
    </div>

    @if(videos.length === 0)
      <div class="text-center py-16 bg-white rounded-xl border border-gray-200">
        <p class="text-gray-500 text-lg">Ainda nenhum vídeo foi publicado.</p>
        <a href="/videos/enviar" class="text-blue-600 font-medium hover:underline mt-2 inline-block">Seja o primeiro a enviar!</a>
      </div>
    @end
  </div>

</body>
</html>